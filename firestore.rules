rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if current user is admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'romanparfinov@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // Products: readable by everyone, writeable by admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog posts: readable by everyone, writeable by admin
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings: readable by everyone, writeable by admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: anyone can create, authenticated users can read their own orders, admin can read/manage all
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Users: each user can read/write their own document, admin can read/write all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }
  }
}
